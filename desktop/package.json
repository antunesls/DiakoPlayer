{
  "name": "diakoplayer",
  "productName": "DiakoPlayer",
  "version": "1.0.0",
  "description": "Player do YouTube Music para PC controlável pela rede (app Android e web).",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.diakoplayer.desktop",
    "productName": "DiakoPlayer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DiakoPlayer"
    },
    "portable": {
      "artifactName": "DiakoPlayer-${version}-portable.exe"
    }
  }
}
